{
	"luci-app-ponwrt-update": {
		"description": "ponwrt firmware update check (GitHub releases)",
		"read": {
			"file": {
				"/usr/bin/ponwrt-update-check": [ "exec" ],
				"/etc/ponwrt-version": [ "read" ],
				"/etc/ponwrt-update.proxy": [ "read" ]
			}
		},
		"write": {
			"file": {
				"/etc/ponwrt-update.proxy": [ "write" ]
			}
		}
	}
}
