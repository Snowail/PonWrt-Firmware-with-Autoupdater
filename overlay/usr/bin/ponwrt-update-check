#!/bin/sh
# ponwrt 固件更新检查 / 下载刷写
#
# 用法:
#   ponwrt-update-check                 人类可读输出
#   ponwrt-update-check --json          输出 JSON（供 LuCI 页面解析）
#   ponwrt-update-check --flash         下载最新固件、校验 SHA256、调用 sysupgrade
#   ponwrt-update-check --proxy URL ... 临时指定代理
#
# GitHub 代理配置：/etc/ponwrt-update.proxy（内容形如 http://10.0.0.5:7897）
# 未配置时代理为空，先试直连；配置了则先走代理，失败再回退直连。

REPO="Snowail/PonWrt-Firmware-with-Autoupdater"
BASE="https://github.com/${REPO}/releases/latest/download"
RAW="https://raw.githubusercontent.com/${REPO}/main/version.json"
LOCAL="/etc/ponwrt-version"
PROXY_FILE="/etc/ponwrt-update.proxy"
INTERVAL="/etc/ponwrt-update.interval"
STATE="/etc/ponwrt-update.state"

PROXY=""
case "${1:-}" in
    --proxy) PROXY="$2"; shift 2 ;;
esac
[ -z "$PROXY" ] && [ -f "$PROXY_FILE" ] && PROXY="$(sed -n '1p' "$PROXY_FILE" | tr -d '\r\n')"

# fetch <url> <out> [timeout]
fetch() {
    if [ -n "$PROXY" ]; then
        curl -fsSL --max-time "${3:-25}" -x "$PROXY" -o "$2" "$1" 2>/dev/null && return 0
        curl -fsSL --max-time "${3:-25}" --noproxy '*' -o "$2" "$1" 2>/dev/null && return 0
        return 1
    fi
    curl -fsSL --max-time "${3:-25}" -o "$2" "$1" 2>/dev/null
}

json_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

cur_built="$(sed -n 's/^built=//p' "$LOCAL" 2>/dev/null)"
cur_commit="$(sed -n 's/^commit=//p' "$LOCAL" 2>/dev/null)"
cur_device="$(sed -n 's/^device=//p' "$LOCAL" 2>/dev/null)"
cur_target="$(sed -n 's/^target=//p' "$LOCAL" 2>/dev/null)"
identity="$cur_device/$cur_built"
now=$(date +%s)
if [ "${1:-}" = --scheduled ]; then
    case "$(cat "$INTERVAL" 2>/dev/null || echo weekly)" in
        daily) period=86400 ;;
        weekly) period=604800 ;;
        monthly) period=2592000 ;;
        *) exit 0 ;;
    esac
    if [ -r "$STATE" ]; then
        { IFS= read -r previous && IFS= read -r checked; } < "$STATE"
        case "$checked" in
            ''|*[!0-9]*) ;;
            *) if [ "$identity" = "$previous" ] && [ "$now" -ge "$checked" ] &&
                  [ "$((now - checked))" -lt "$period" ]; then exit 0; fi ;;
        esac
    fi
fi

work=$(mktemp -d /tmp/ponwrt-check.XXXXXX) || exit 1
TMPJ="$work/remote.json"
TMPF="$work/image.itb"
trap 'rm -f "$TMPJ" "$TMPF"; rmdir "$work"' EXIT
trap 'exit 1' HUP INT TERM

latest=""; lcommit=""; lbuilt=""; lfile=""; lsha=""; lnotes=""; lurl=""; err=""

# 优先取仓库里的 version.json（raw 的缓存很短），再退回 Release 资产
if fetch "$RAW?t=$(date +%s)" "$TMPJ" || fetch "$RAW" "$TMPJ" || \
   fetch "$BASE/version.json?t=$(date +%s)" "$TMPJ" || fetch "$BASE/version.json" "$TMPJ"; then
    latest="$(jsonfilter -i "$TMPJ" -e '@.version' 2>/dev/null)"
    lcommit="$(jsonfilter -i "$TMPJ" -e '@.commit' 2>/dev/null)"
    lbuilt="$(jsonfilter -i "$TMPJ" -e '@.built' 2>/dev/null)"
    lfile="$(jsonfilter -i "$TMPJ" -e '@.file' 2>/dev/null)"
    lsha="$(jsonfilter -i "$TMPJ" -e '@.sha256' 2>/dev/null)"
    lnotes="$(jsonfilter -i "$TMPJ" -e '@.notes' 2>/dev/null)"
    ldevice="$(jsonfilter -i "$TMPJ" -e '@.device' 2>/dev/null)"
    lurl="$(jsonfilter -i "$TMPJ" -e '@.download_url' 2>/dev/null)"
    [ -n "$latest" ] || err="version.json 解析失败"
    if [ -z "$cur_device" ] || [ -z "$cur_target" ] || [ "$ldevice" != "$cur_device" ] || \
       [ "$lfile" != "ponwrt-airoha-${cur_target}-${cur_device}-squashfs-sysupgrade.itb" ]; then
        err="固件机型与当前设备不匹配"
    fi
    if ! printf '%s\n' "$lsha" | grep -Eq '^[0-9a-f]{64}$'; then err="固件校验信息无效"; fi
    if [ -n "$lurl" ]; then
        case "$lurl" in
            "https://github.com/${REPO}/releases/download/"*"/$lfile") ;;
            *) err="固件下载地址无效" ;;
        esac
    else
        lurl="$BASE/$lfile"
    fi
else
    err="无法访问 GitHub Release（可设置代理后重试）"
fi

update=0
if [ -z "$err" ] && ! printf '%s\n' "$cur_built" "$lbuilt" | awk '
    length != 15 || $0 !~ /^[0-9]+-[0-9]+$/ || substr($0,9,1) != "-" { exit 1 }'; then
    err="固件编译时间无效"
fi
case "$latest" in *[!a-zA-Z0-9._-]*) err="固件版本标记无效";; esac
if [ -z "$err" ] && [ -n "$latest" ] && \
   LC_ALL=C awk -v latest="$lbuilt" -v current="$cur_built" 'BEGIN { exit !(("x" latest) > ("x" current)) }'; then
    update=1
fi

# Bind the notice to the installed image. Failed checks keep the last verified result.
if [ -z "$err" ]; then
    notice=""
    [ "$update" != 1 ] || notice="$latest"
    tmpstate=$(mktemp "$STATE.XXXXXX") || exit 1
    if ! printf '%s\n' "$identity" "$now" "$notice" "$latest" > "$tmpstate" || ! mv -f "$tmpstate" "$STATE"; then
        rm -f "$tmpstate"
        exit 1
    fi
fi

case "${1:-}" in
    --scheduled) [ -z "$err" ] ;;
    --json)
        printf '{"current":"%s","cur_built":"%s","cur_commit":"%s","device":"%s",' \
            "$(json_esc "${cur_device:-unknown}")" "$(json_esc "$cur_built")" "$(json_esc "$cur_commit")" "$(json_esc "$cur_device")"
        printf '"latest":"%s","latest_built":"%s","latest_commit":"%s","file":"%s","sha256":"%s","notes":"%s","update":%d,"error":"%s","proxy":"%s"}\n' \
            "$(json_esc "$latest")" "$(json_esc "$lbuilt")" "$(json_esc "$lcommit")" \
            "$(json_esc "$lfile")" "$(json_esc "$lsha")" "$(json_esc "$lnotes")" "$update" \
            "$(json_esc "$err")" "$(json_esc "$PROXY")"
        ;;
    --flash)
        [ -z "$err" ] || { echo "$err"; exit 1; }
        [ -n "$lfile" ] || { echo "没有可用的固件信息"; exit 1; }
        [ "$update" = "1" ] || { echo "已是最新版本，无需刷写"; exit 0; }
        echo "下载 $lfile ..."
        fetch "$lurl" "$TMPF" 900 || { echo "下载失败"; exit 1; }
        echo "校验 SHA256 ..."
        got="$(sha256sum "$TMPF" | awk '{print $1}')"
        if [ "$got" != "$lsha" ]; then
            echo "校验失败：期望 $lsha 实际 $got"; rm -f "$TMPF"; exit 1
        fi
        sysupgrade -T "$TMPF" || { echo "设备固件兼容性检查失败"; exit 1; }
        echo "校验通过，开始刷写（保留配置）..."
        sysupgrade "$TMPF"
        ;;
    *)
        [ -n "$PROXY" ] && echo "代理: $PROXY"
        echo "当前: ${cur_device:-unknown} / ${cur_built:-unknown} (${cur_commit})"
        if [ -n "$err" ]; then echo "检查失败: $err"; exit 1; fi
        echo "最新: $latest (${lbuilt})"
        [ "$update" = "1" ] && echo "状态: 发现新版本" || echo "状态: 已是最新"
        ;;
esac
